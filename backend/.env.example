# 应用配置

# --- 应用基础配置 ---
PROJECT_NAME="Yend2 Awesome App"
PROJECT_VERSION="0.1.0"
API_V1_STR="/api/v1"
# development, testing, production
APP_ENV="development" 
DEBUG_MODE=True
APP_HOST="0.0.0.0"
APP_PORT=8000

# 用于JWT签名等，务必修改且保密 可以 openssl rand -hex 32
SECRET_KEY=''
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 数据库配置 (SQLAlchemy URL)
# 示例:
# PostgreSQL: postgresql+asyncpg://user:password@host:port/dbname
# MySQL: mysql+aiomysql://user:password@host:port/dbname
# SQLite (异步): sqlite+aiosqlite:///./yend2.db
# SQLite (同步, 不推荐用于FastAPI生产): sqlite:///./yend2.db
DATABASE_URL='postgresql+asyncpg://test:1234@192.168.4.10:35432/yend2'

# 跨域配置 (CORS)
# 允许的源列表，用逗号分隔，例如: http://localhost:3000,https://yourdomain.com
# 在开发时可以是 '*'，生产环境务必指定明确的域名
# CORS_ALLOWED_ORIGINS='*' 
CORS_ALLOWED_ORIGINS='http://192.168.4.10:5173' 

# 推送服务配置 (示例)
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# DINGTALK_ROBOT_TOKEN_DEFAULT=

# 邮件服务配置 (如果需要邮件推送/找回密码等)
# MAIL_SERVER=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=True
# MAIL_SENDER=
